# Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Database Connection (Separate parameters for local setup)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=team_task_manager
DB_USER=postgres
DB_PASSWORD=your_database_password

# Database Connection (Single Connection URL - Preferred for Production e.g., Render/Supabase)
# DATABASE_URL=postgres://user:password@host:port/database

# Session Secret (Use a long, secure random string)
SESSION_SECRET=a_very_long_secure_random_session_secret_change_me

# Frontend URL (For CORS configuration in production)
FRONTEND_URL=http://localhost:5173
